# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows Batch & CMD files must retain CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Source and documentation
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
